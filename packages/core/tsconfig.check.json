{
  // tsconfig for `pnpm type-check`: everything in `tsconfig.app.json`, including
  // tests (`*.test.ts`, `*.browser.test.ts`, `*.test-d.ts`) and stories, so CI
  // catches type errors there too.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Keep the incremental cache apart from `tsconfig.app.json`'s.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.check.tsbuildinfo"
  }
}
