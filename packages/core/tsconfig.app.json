{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "paths": {
      "@/*": ["./src/*"],
      "@iconify/vue": ["../../.histoire/node_modules/@iconify/vue"]
    },
    // TODO: set skipLibCheck to false (#2043)
    // Ideally we should set this to false, but histoire and vueuse are being difficult...
    // For now, keep it disabled...
    "skipLibCheck": true
  },
  // No `fallthroughAttributes`: the emitted `.d.ts` would not change. Component props
  // accept HTML attributes for downstream `strictTemplates` through `PrimitiveProps`
  // (type-only, see `PrimitiveHTMLAttributes`), checked by `pnpm test:types`.
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
