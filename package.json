{
  "name": "reka-ui",
  "type": "module",
  "version": "2.8.2",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "license": "MIT",
  "repository": "unovue/reka-ui",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "story:dev": "storybook dev -p 6007 --config-dir .storybook",
    "story:build": "storybook build --config-dir .storybook -o storybook-static",
    "story:preview": "npx serve storybook-static",
    "build": "pnpm run --filter reka-ui build && pnpm run --filter plugins build",
    "build-only": "pnpm run -r build-only",
    "docs:install": "pnpm --filter docs install",
    "docs:dev": "pnpm --filter docs docs:dev",
    "docs:build": "pnpm --filter docs docs:build",
    "docs:gen": "pnpm --filter docs docs:gen",
    "docs:contributors": "pnpm --filter docs docs:contributors",
    "prepare": "pnpm simple-git-hooks",
    "test": "pnpm --filter reka-ui test",
    "test-update": "pnpm --filter reka-ui test-update",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bumpp": "bumpp package.json packages/*/package.json docs/package.json",
    "pub:release": "cd packages/core && pnpm pub:release"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@storybook/addon-docs": "10.2.10",
    "@storybook/addon-themes": "10.2.10",
    "@storybook/vue3-vite": "10.2.10",
    "@vitejs/plugin-vue": "^6.0.4",
    "addon-vue-csf": "file:../../UnoVue/addon-vue-csf",
    "autoprefixer": "^10.4.20",
    "bumpp": "^10.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-storybook": "10.2.10",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "simple-git-hooks": "^2.13.1",
    "storybook": "10.2.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vue": "3.5.17"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
