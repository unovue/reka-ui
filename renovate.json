{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Kuala_Lumpur",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    },
    {
      "groupName": "test",
      "matchPackageNames": [
        "vitest",
        "jsdom",
        "@vue/test-utils",
        "@vitest{/,}**",
        "@testing-library{/,}**",
        "vitest{/,}**"
      ]
    },
    {
      "groupName": "build",
      "matchPackageNames": [
        "vite",
        "vite-{/,}**",
        "@vitejs{/,}**"
      ]
    },
    {
      "groupName": "lint",
      "matchPackageNames": [
        "eslint",
        "simple-git-hooks",
        "lint-staged",
        "@antfu/eslint-config",
        "eslint{/,}**"
      ]
    },
    {
      "groupName": "vue",
      "matchPackageNames": [
        "vue",
        "vue-tsc",
        "@vue/{/,}**",
        "vue-{/,}**",
        "!@vue/test-utils"
      ]
    }
  ],
  "ignoreDeps": [
    "reka-ui",
    "node",
    "typescript"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "playground/**"
  ]
}
